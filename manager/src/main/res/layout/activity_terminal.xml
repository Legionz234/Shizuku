<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="?actionBarSize"
    app:fitsSystemWindowsInsets="bottom|top">

    <!-- 输出可能很长，纵向滚动；单行可能很宽（dumpsys 之类），所以里面再套一层横向滚动 -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TextView
                android:id="@+id/output"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:typeface="monospace" />

        </HorizontalScrollView>

    </ScrollView>

    <!-- 当前基准目录（shell 自己维护 $PWD，cd 之后随之变化） -->
    <TextView
        android:id="@+id/cwd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/terminal_cwd_label"
        android:ellipsize="start"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:typeface="monospace" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <!-- 软按键：手机键盘上没有 Ctrl/Alt/方向键，这排用来补上 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <Button
                android:id="@+id/key_ctrl"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="56dp"
                android:text="@string/terminal_key_ctrl"
                android:textSize="13sp" />

            <Button
                android:id="@+id/key_alt"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="56dp"
                android:text="@string/terminal_key_alt"
                android:textSize="13sp" />

            <Button
                android:id="@+id/key_left"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="@string/terminal_key_left"
                android:minWidth="48dp"
                android:text="←"
                android:textSize="16sp" />

            <Button
                android:id="@+id/key_up"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="@string/terminal_key_up"
                android:minWidth="48dp"
                android:text="↑"
                android:textSize="16sp" />

            <Button
                android:id="@+id/key_down"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="@string/terminal_key_down"
                android:minWidth="48dp"
                android:text="↓"
                android:textSize="16sp" />

            <Button
                android:id="@+id/key_right"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="@string/terminal_key_right"
                android:minWidth="48dp"
                android:text="→"
                android:textSize="16sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/terminal_input_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:maxLines="1"
            android:textSize="14sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/run"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terminal_run" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/stop"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terminal_stop" />

        <Button
            android:id="@+id/clear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terminal_clear" />

    </LinearLayout>

</LinearLayout>
